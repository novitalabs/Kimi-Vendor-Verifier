{
  "name": "kimi-k2.6",
  "description": "Moonshot Kimi-K2.6, general-purpose K2 model.",
  "preserve_thinking": 0,
  "recommended_smoke_concurrency": 4,
  "recommended_extended_concurrency": 4,
  "tracks": {
    "official": {
      "base_url": "https://api.ppio.com/openai/v1",
      "api_key": "$PPIO_API_KEY",
      "headers": {
        "X-Fusion-Provider": "moonshot-openai"
      },
      "model_id": "moonshotai/kimi-k2.6",
      "notes": "Via PPIO gateway (X-Fusion-Provider routes to Moonshot upstream). concurrency>5 triggers PPIO agent-timeout on long tasks."
    },
    "self": {
      "description": "Self-deployed vLLM. Provide --self-url --self-key --self-header via CLI."
    }
  }
}
